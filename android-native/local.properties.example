# Copy this file to local.properties for local Android development.
# Do not commit local.properties.

# Android SDK location for this workstation.
sdk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk

# Public Supabase client configuration only.
# Phase 2 native Android builds are locked to verified staging.
# Never add service-role keys, payment secrets, signing passwords, or service-account JSON here.
SUPABASE_URL=https://pxobauvatbjncluuunyq.supabase.co
SUPABASE_ANON_KEY=your-staging-public-anon-or-publishable-key

# The Gradle build also accepts these existing web aliases:
