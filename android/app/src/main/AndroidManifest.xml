<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ═══════════════════════════════════
         PERMISSIONS
    ═══════════════════════════════════ -->

    <!-- Core Networking -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Push Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Camera (Face Verification, Snaps, Campus Finder) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Google Play Photo & Video Permissions Policy Compliance:
         Broad storage/media permissions are strictly excluded. The app uses the
         Android system photo picker / Storage Access Framework (SAF) for photo picking. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />

    <!-- Audio (Voice & Video Calls via Agora RTC) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- Location (Live Location Sharing) -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- Optional hardware features (non-required) -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".MainApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:hardwareAccelerated="true">

        <!-- OneSignal App ID for native background push wakeups -->
        <meta-data
            android:name="onesignal_app_id"
            android:value="eda29312-5e13-406f-a1bd-5c8a8e27e6c4" />

        <!-- OneSignal Google Project Number linking FCM Sender ID -->
        <meta-data
            android:name="onesignal_google_project_number"
            android:value="str:681959308566" />

        <!-- ═══════════════════════════════════
             MAIN ACTIVITY
        ═══════════════════════════════════ -->
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:name=".MainActivity"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:windowSoftInputMode="adjustResize">
            <!-- Default launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ═══════════════════════════════════
                 SUPABASE OAUTH DEEP LINK
                 Handles: com.collegedate.app://auth/callback
                 Required for Google/email OAuth to return to app
            ═══════════════════════════════════ -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/custom_url_scheme" />
            </intent-filter>

            <!-- HTTPS app links from thecollegedate.com for OAuth and push notification taps. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.thecollegedate.com"
                    android:pathPrefix="/auth/callback"
                />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/reset-password" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/payment/callback" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/dashboard" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/match" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/explore" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/chat" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/messages" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/status" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/snap" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/profile" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/settings" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/referrals" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/wallet" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/requests" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/leaderboard" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/confessions" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/premium" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/viewers" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/notifications" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/notification-preview" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/notification-preview-lab" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/push-preview" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/push-lab" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/mini-profile-setup" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/call" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/admin" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/guides" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/official" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/ask" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/terms" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/privacy" />
                <data android:scheme="https" android:host="www.thecollegedate.com" android:pathPrefix="/safety" />
            </intent-filter>
        </activity>

        <!-- ═══════════════════════════════════
             BOOT RECEIVERS & PERFORMANCE HARDENING
             LocalNotificationRestoreReceiver executes synchronously on LOCKED_BOOT_COMPLETED,
             triggering ANRs on low-end devices and emulators. Removed to eliminate boot stalls.
        ═══════════════════════════════════ -->
        <receiver
            android:name="com.capacitorjs.plugins.localnotifications.LocalNotificationRestoreReceiver"
            tools:node="remove" />

        <!-- ═══════════════════════════════════
             FILE PROVIDER
             Required for camera/file upload on Android 7+
        ═══════════════════════════════════ -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
